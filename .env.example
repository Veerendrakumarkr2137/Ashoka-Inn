# ==============================================================================
# HOSPITALITY OS / HOTEL PMS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# In production, set these variables in your hosting platform (Vercel, Supabase, AWS, Render).
# ==============================================================================

# ─── 1. CORE & ROUTING ────────────────────────────────────────────────────────
NODE_ENV=development
PORT_GUEST_WEB=3000
PORT_ADMIN_PMS=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_HOTEL_NAME="Hotel Ashokha"

# ─── 2. DATABASE & ORM ────────────────────────────────────────────────────────
# PostgreSQL Connection (Supabase Cloud or Local Docker PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/hotel_pms?schema=public
DATABASE_URL="file:./dev.db"

# ─── 3. AUTHENTICATION & SECURITY ─────────────────────────────────────────────
ADMIN_PASSWORD=admin123
AUTH_SECRET=super-secret-auth-key-change-in-production
JWT_SECRET=super-secret-jwt-key-change-in-production

# ─── 4. SUPABASE CLOUD INTEGRATION ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xnvkoqdjecrspbwynoag.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fpO29vMmxS8AsIpreZQKRw_y4WoBQh9

# ─── 5. EXTERNAL PROVIDERS & SERVICE ADAPTERS ──────────────────────────────────
# Voice Provider (mock | livekit | twilio)
VOICE_PROVIDER=mock
LIVEKIT_URL=https://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# WhatsApp Provider (mock | meta | twilio)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Email Provider (mock | resend | smtp)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payment Provider (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
NEXT_PUBLIC_PAYMENT_KEY_ID=

# ─── 6. AUTOMATION & N8N ORCHESTRATION ─────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=n8n-secure-webhook-secret-key-12345
