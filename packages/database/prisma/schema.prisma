// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // We'll use SQLite for rapid development, easily swappable to PostgreSQL later
  url      = env("DATABASE_URL")
}

// ─── 1. CORE & USERS ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("GUEST") // GUEST, RECEPTIONIST, ADMIN, etc.
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings      Booking[]
  payments      Payment[]
  reviews       Review[]
  supportTickets SupportTicket[]
}

// ─── 2. INVENTORY & ROOMS ─────────────────────────────────────────────────────

model RoomCategory {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Deluxe Non-AC", "Superior AC", "Family AC", "King Suite"
  description String
  basePrice   Float
  capacity    Int      @default(2)
  sizeSqm     Int?
  
  // Amenities flags based on notes
  hasAC       Boolean  @default(true)
  hasTV       Boolean  @default(true)
  hasKettle   Boolean  @default(true)
  hasWater    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]
  images      RoomImage[]
}

model RoomImage {
  id             String       @id @default(cuid())
  url            String
  roomCategoryId String
  category       RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
}

model Room {
  id             String       @id @default(cuid())
  roomNumber     String       @unique // e.g., "101", "102"
  status         String       @default("AVAILABLE") // AVAILABLE, OCCUPIED, CLEANING, MAINTENANCE
  roomCategoryId String
  category       RoomCategory @relation(fields: [roomCategoryId], references: [id])
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  allocations        RoomAllocation[]
  maintenanceTickets MaintenanceTicket[]
}

model MaintenanceTicket {
  id           String    @id @default(cuid())
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  issue        String
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String    @default("REPORTED") // REPORTED, ASSIGNED, IN_PROGRESS, WAITING_PARTS, COMPLETED, INSPECTED
  technician   String?   @default("Unassigned")
  notes        String?
  reportedBy   String    @default("Front Desk Staff")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── 3. BOOKINGS & OPERATIONS ─────────────────────────────────────────────────

model Booking {
  id            String    @id @default(cuid())
  bookingRef    String    @unique // e.g., "BKG-12345"
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  checkIn       DateTime
  checkOut      DateTime
  actualCheckIn DateTime?
  actualCheckOut DateTime?
  adults        Int       @default(2)
  children      Int       @default(0)
  totalAmount   Float
  discountAmount Float    @default(0)
  taxAmount     Float     @default(0)
  status        String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED, CHECKED_IN, CHECKED_OUT, COMPLETED
  
  specialRequests String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  allocations   RoomAllocation[]
  payments      Payment[]
  orders        ServiceOrder[] // In-room dining, laundry
  notes         BookingNote[]
  folioCharges  FolioCharge[]
  aiCallSessions AiCallSession[]
}


model BookingNote {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  message   String
  author    String   @default("Front Desk Staff")
  createdAt DateTime @default(now())
}

model FolioCharge {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category    String   // ROOM, RESTAURANT, ROOM_SERVICE, LAUNDRY, DRY_CLEANING, EXTRA_BED, TRANSPORT, MINIBAR, OTHER_SERVICES, DAMAGE, MISSING_ITEMS, CUSTOM
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  taxAmount   Float    @default(0)
  totalAmount Float
  source      String   @default("FRONT_DESK") // FRONT_DESK, RESTAURANT, HOUSEKEEPING, SERVICE_HUB
  author      String   @default("Staff")
  createdAt   DateTime @default(now())
}

model RoomAllocation {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  
  checkIn   DateTime
  checkOut  DateTime
  
  createdAt DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  amount        Float
  currency      String   @default("INR")
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod String?  // CARD, UPI, CASH
  transactionId String?
  
  createdAt     DateTime @default(now())
}

// ─── 4. HOTEL SERVICES (Based on Notes) ───────────────────────────────────────

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Room Service", "Laundry", "Car Wash", "Bar", "Restaurant"
  services    ServiceItem[]
}

model ServiceItem {
  id          String   @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Float
  isAvailable Boolean  @default(true)
  
  orders      ServiceOrderItem[]
}

model ServiceOrder {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  status      String   @default("PENDING") // PENDING, PREPARING, DELIVERED, COMPLETED
  totalAmount Float
  
  items       ServiceOrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceOrderItem {
  id            String       @id @default(cuid())
  orderId       String
  order         ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceItemId String
  serviceItem   ServiceItem  @relation(fields: [serviceItemId], references: [id])
  quantity      Int          @default(1)
  priceAtTime   Float
}

// ─── 5. FEEDBACK & SUPPORT ────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?
  status    String   @default("PENDING") // PENDING, PUBLISHED, HIDDEN
  
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactInquiry {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  inquiryType String
  message     String
  status      String   @default("NEW") // NEW, REPLIED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── 6. OPERATIONAL PMS TASK ENGINE & AUDIT LOGS ──────────────────────────────

model Task {
  id            String    @id @default(cuid())
  type          String    // CLEANING, INSPECTION, MAINTENANCE, SERVICE
  title         String
  description   String?
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedStaff String?   @default("Unassigned")
  roomId        String?
  bookingId     String?
  startTime     DateTime?
  completedTime DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Inspection {
  id                 String   @id @default(cuid())
  roomId             String
  bookingId          String?
  inspector          String   @default("Housekeeping Supervisor")
  status             String   @default("PASSED") // PASSED, FAILED
  checklistJson      String   // JSON formatted checklist results
  totalDamageCharge  Float    @default(0)
  notes              String?
  createdAt          DateTime @default(now())
}

model DamagePriceConfig {
  id        String   @id @default(cuid())
  itemName  String   @unique // Towel, AC Remote, Kettle, Glass, Bedsheet, TV Remote, etc.
  price     Float
  category  String   @default("LINEN_ITEMS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  category  String   // BOOKING, ROOM, HOUSEKEEPING, INSPECTION, DAMAGE, PAYMENT, SERVICE
  action    String   // CHECK_IN, CHECK_OUT, START_CLEANING, INSPECTION_PASSED, DAMAGE_ADDED, ORDER_CREATED
  message   String
  author    String   @default("System Audit")
  roomId    String?
  bookingId String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── 7. AI RECEPTIONIST CALL SESSIONS & LOGS ───────────────────────────────────

model AiCallSession {
  id                 String    @id @default(cuid())
  bookingId          String?
  booking            Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  provider           String    @default("mock") // mock, livekit, twilio
  externalCallId     String?
  status             String    @default("CREATED") // CREATED, STARTING, RINGING, CONNECTED, IN_PROGRESS, COMPLETED, NO_ANSWER, BUSY, FAILED, CANCELLED, ESCALATED
  language           String    @default("en-IN")
  startedAt          DateTime?
  connectedAt        DateTime?
  endedAt            DateTime?
  duration           Int       @default(0) // seconds
  summary            String?
  sentiment          String?   @default("NEUTRAL") // POSITIVE, NEUTRAL, NEGATIVE, FRUSTRATED
  arrivalTime        String?
  escalationRequired Boolean   @default(false)
  failureReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}


